{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "rootDir": "src",
        "outDir": "dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        // 👇 thêm cấu hình alias
        "baseUrl": "src",
        "paths": {
            "@/*": ["*"],
            "@prisma": ["prisma/index.ts"],
            "@utils/*": ["utils/*"],
            "@modules/*": ["modules/*"]
        }
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules"]
}

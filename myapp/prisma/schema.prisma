generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  active
  suspended
  graduated
  dropped
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)   // ví dụ: "user:create"
  description String?   @db.VarChar(255)
  groupName   String?   @db.VarChar(100)           // ví dụ: "User & Role Management"
  createdAt   DateTime  @default(now())

  roles       RolePermission[]
}


model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(200)
  createdAt   DateTime         @default(now())

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId]) // composite key
}


model User {
  id            Int           @id @default(autoincrement())
  studentCode  String? @unique @db.VarChar(30)   // 👈 nullable
  email         String?       @unique @db.VarChar(100)  // email giờ optional
  passwordHash  String        @db.VarChar(255)
  fullName      String        @db.VarChar(120)
  avatarUrl     String?       @db.VarChar(500)
  phone         String?       @db.VarChar(20)
  dateOfBirth   DateTime?
  address       String?       @db.VarChar(200)
  roleId        Int
  isActive      Boolean       @default(true)
  emailVerified Boolean       @default(false)
  lastLogin     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  role          Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  student       Student?
  teacher       Teacher?
  refreshTokens RefreshToken[]
  uploadedMaterials Material[]
  forumThreads ForumThread[] @relation("UserThreads") // 👈 đặt tên nếu nhiều quan hệ với User
  forumPosts ForumPost[] @relation("UserPosts") // 👈 quan hệ ngược
  notifications Notification[] // 👈 ngược lại
  reminders Reminder[] // 👈 ngược lại
  learningPaths LearningPath[] // 👈 ngược lại
  auditLogs AuditLog[] // 👈 ngược lại

  @@index([roleId])
  @@index([isActive])
  @@index([lastLogin])
}


model Student {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  studentCode    String        @unique @db.VarChar(30)
  className      String?       @db.VarChar(50)
  major          String?       @db.VarChar(100)
  academicYear   String?       @db.VarChar(15)
  enrollmentYear Int?
  gpa            Decimal?      @default(0.00) @db.Decimal(4, 2)
  status         StudentStatus @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    SectionEnrollment[]  // 👈 thêm relation ngược lại
  submissions Submission[]  // 👈 quan hệ ngược
  learningPaths LearningPath[] // 👈 ngược lại
  attendances Attendance[]

  @@index([status])
  @@index([className])
  @@index([major])
}

model Teacher {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  teacherCode    String   @unique @db.VarChar(30)
  department     String?  @db.VarChar(120)
  position       String?  @db.VarChar(80)
  specialization String?  @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections       SectionInstructor[]  // 👈 thêm relation ngược lại

  @@index([department])
  @@index([position])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// Enums
enum CourseSectionStatus {
  planned
  ongoing
  completed
  cancelled
}

enum InstructorRole {
  owner
  co
  ta
}

enum EnrollmentStatus {
  enrolled
  dropped
  completed
}

// Subjects (Danh mục môn học)
model Subject {
  id           Int             @id @default(autoincrement())
  subjectCode  String          @unique @db.VarChar(30)
  subjectName  String          @db.VarChar(200)
  credits      Int             @default(3)

  // Relations
  courseSections CourseSection[]

  @@index([subjectCode])
}

// Terms (Kỳ học)
model Term {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(30)
  name      String    @db.VarChar(100)
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  // Relations
  courseSections CourseSection[]

  @@index([code])
}

// Course sections (Lớp học phần)
model CourseSection {
  id              Int                  @id @default(autoincrement())
  subjectId       Int
  termId          Int
  sectionCode     String               @unique @db.VarChar(40)
  sectionName     String?   // nullable
  schedule        Json?
  maxStudents     Int                  @default(50)
  currentStudents Int                  @default(0)
  status          CourseSectionStatus  @default(planned)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term        Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  instructors SectionInstructor[]
  groups      SectionGroup[]
  enrollments SectionEnrollment[]
  assignments Assignment[]   // 👈 thêm quan hệ ngược
  forumThreads ForumThread[] // 👈 ngược lại
  attendanceSessions AttendanceSession[]
  materials   CourseMaterial[]  // 👈 tài liệu của lớp

  @@index([subjectId])
  @@index([termId])
  @@index([sectionCode])
}

// Section instructors (Phân công giảng viên cho học phần)
// Composite primary key (sectionId, teacherId) như trong DDL
model SectionInstructor {
  sectionId Int
  teacherId Int
  role      InstructorRole @default(owner)
  assignedAt DateTime      @default(now())

  // Relations
  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([sectionId, teacherId])
  @@index([teacherId])
  @@index([sectionId])
}

// Section groups (Nhóm trong học phần)
model SectionGroup {
  id          Int          @id @default(autoincrement())
  sectionId   Int
  groupCode   String?      @db.VarChar(40)
  groupName   String?      @db.VarChar(100)
  maxMembers  Int          @default(6)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  section     CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  enrollments SectionEnrollment[]   // 👈 thêm quan hệ ngược lại

  @@unique([id, sectionId], map: "uniq_group_section")
  @@index([sectionId], map: "idx_section")
}


// Section enrollments (Sinh viên đăng ký học phần)
model SectionEnrollment {
  id         Int               @id @default(autoincrement())
  sectionId  Int
  studentId  Int
  groupId    Int?

  status     EnrollmentStatus  @default(enrolled)
  enrolledAt DateTime          @default(now())

  // Relations
  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   SectionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([sectionId, studentId], map: "uniq_section_student")
  @@index([studentId])
  @@index([sectionId])
  @@index([groupId])
}

// Loại tài liệu
enum MaterialCategory {
  lecture     // Bài giảng
  slide       // Slide
  exercise    // Bài tập
  reference   // Tài liệu tham khảo
  syllabus    // Đề cương
  other       // Khác
}

// Bảng tài liệu
model Material {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  fileName      String?
  filePath      String?
  fileSize      BigInt?
  fileType      String?
  category      MaterialCategory  @default(other)
  isPublic      Boolean   @default(false)
  downloadCount Int       @default(0)
  uploadedBy    Int
  uploadedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Quan hệ
  uploader    User             @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  courseLinks CourseMaterial[] @relation("MaterialToCourse")
}

model CourseMaterial {
  id              Int           @id @default(autoincrement())
  courseSectionId Int
  materialId      Int
  assignedAt      DateTime      @default(now())
  isOpen          Boolean       @default(true)

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  material        Material      @relation("MaterialToCourse", fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, materialId])
}


enum AssignmentType {
  exercise     // Bài tập
  quiz         // Trắc nghiệm
  project      // Đồ án / nhóm
  exam         // Thi
}

model Assignment {
  id           Int             @id @default(autoincrement())
  sectionId    Int
  title        String          @db.VarChar(200)
  description  String?         @db.Text
  type         AssignmentType  @default(exercise)
  dueDate      DateTime?
  maxScore     Int             @default(100)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  section      CourseSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submissions  Submission[]
}

model Submission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  filePath     String?    @db.VarChar(500)   // file nộp
  answerText   String?    @db.Text           // câu trả lời text/code
  score        Int?
  feedback     String?    @db.Text
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model ForumThread {
  id          Int      @id @default(autoincrement())
  sectionId   Int
  title       String   @db.VarChar(200)
  content     String   @db.Text
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User @relation("UserThreads", fields: [createdBy], references: [id], onDelete: Cascade)

  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  posts       ForumPost[]
}

model ForumPost {
  id          Int      @id @default(autoincrement())
  threadId    Int
  content     String   @db.Text
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  votes       Int      @default(0)
  author      User @relation("UserPosts", fields: [createdBy], references: [id], onDelete: Cascade)

  thread      ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String   @db.VarChar(200)
  message     String?  @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          Int      @id @default(autoincrement())
  userId      Int
  content     String   @db.VarChar(200)
  remindAt    DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id          Int      @id @default(autoincrement())
  studentId   Int
  userId      Int      // 👈 thêm field này
  title       String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items       LearningItem[]
}

model LearningItem {
  id            Int      @id @default(autoincrement())
  learningPathId Int
  resourceType  String   @db.VarChar(50)   // "subject", "video", "course"
  resourceUrl   String?  @db.VarChar(500)
  recommendationNote String? @db.Text
  priority      Int      @default(1)

  path          LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String   @db.VarChar(200)
  target    String?  @db.VarChar(200)
  details   Json?
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AttendanceSession {
  id          Int           @id @default(autoincrement())
  sectionId   Int
  name        String?       // 👈 tên buổi điểm danh
  sessionCode String        @unique
  qrCodeUrl   String?
  latitude    Float?
  longitude   Float?
  radius      Float?        @default(50) // mét
  createdAt   DateTime      @default(now())
  expiresAt   DateTime?     // 👈 thời gian hết hạn

  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attendances Attendance[]
}


model Attendance {
  id         Int                @id @default(autoincrement())
  sessionId  Int
  studentId  Int
  status     AttendanceStatus   @default(present)
  note       String?           @db.Text         
  checkedInAt DateTime          @default(now())
  latitude   Float?
  longitude  Float?
  distance   Float?             // khoảng cách tính được

  session    AttendanceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId], map: "uniq_attendance")
}

enum AttendanceStatus {
  present
  late
  absent
  warning
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  active
  suspended
  graduated
  dropped
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  groupName   String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            Int       @id @default(autoincrement())
  studentCode   String?   @unique @db.VarChar(30)
  email         String?   @unique @db.VarChar(100)
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(120)
  avatarUrl     String?   @db.VarChar(500)
  phone         String?   @db.VarChar(20)
  dateOfBirth   DateTime?
  address       String?   @db.VarChar(200)
  roleId        Int
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role              Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  student           Student?
  teacher           Teacher?
  refreshTokens     RefreshToken[]
  uploadedMaterials Material[]
  forumThreads      ForumThread[]     @relation("UserThreads")
  forumPosts        ForumPost[]       @relation("UserPosts")
  notifications     Notification[]
  reminders         Reminder[]
  learningPaths     LearningPath[]
  auditLogs         AuditLog[]
  chatMessages      ChatMessage[]
  chatParticipants  ChatParticipant[]
  overriddenGrades  StudentGrade[]    @relation("GradeOverriddenBy")
  assignedMaterials CourseMaterial[]   // ← THÊM DÒNG NÀY

  @@index([roleId])
  @@index([isActive])
  @@index([lastLogin])
}

model Student {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  studentCode    String        @unique @db.VarChar(30)
  className      String?       @db.VarChar(50)
  major          String?       @db.VarChar(100)
  academicYear   String?       @db.VarChar(15)
  enrollmentYear Int?
  gpa            Decimal?      @default(0.00) @db.Decimal(4, 2)
  status         StudentStatus @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    SectionEnrollment[]
  submissions    Submission[]
  learningPaths  LearningPath[]
  attendances    Attendance[]
  studentGrades  StudentGrade[]

  @@index([status])
  @@index([className])
  @@index([major])
}

model Teacher {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  teacherCode    String   @unique @db.VarChar(30)
  department     String?  @db.VarChar(120)
  position       String?  @db.VarChar(80)
  specialization String?  @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections SectionInstructor[]

  @@index([department])
  @@index([position])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum CourseSectionStatus {
  planned
  ongoing
  completed
  cancelled
}

enum InstructorRole {
  owner
  co
  ta
}

enum EnrollmentStatus {
  enrolled
  dropped
  completed
}

model Subject {
  id          Int    @id @default(autoincrement())
  subjectCode String @unique @db.VarChar(30)
  subjectName String @db.VarChar(200)
  credits     Int    @default(3)

  courseSections CourseSection[]

  @@index([subjectCode])
}

model Term {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(30)
  name      String    @db.VarChar(100)
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  courseSections CourseSection[]

  @@index([code])
}

model CourseSection {
  id              Int                 @id @default(autoincrement())
  subjectId       Int
  termId          Int
  sectionCode     String
  sectionName     String?
  schedule        Json?
  maxStudents     Int                 @default(50)
  currentStudents Int                 @default(0)
  status          CourseSectionStatus @default(planned)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  subject        Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term           Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  instructors    SectionInstructor[]
  groups         SectionGroup[]
  enrollments    SectionEnrollment[]
  forumThreads   ForumThread[]
  materials      CourseMaterial[]
  assignments    SectionAssignment[]
  notifications  Notification[]
  chatRooms      ChatRoom[]
  gradeColumns   GradeColumn[]
  attendanceScoreRules AttendanceScoreRule[]

  // chỉ cần 1 field này thôi
  attendanceSessions AttendanceSession[]

  @@index([subjectId])
  @@index([termId])
  @@index([sectionCode])
}


model SectionInstructor {
  sectionId  Int
  teacherId  Int
  role       InstructorRole @default(owner)
  assignedAt DateTime       @default(now())

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([sectionId, teacherId])
  @@index([teacherId])
  @@index([sectionId])
}

model SectionGroup {
  id         Int      @id @default(autoincrement())
  sectionId  Int
  groupCode  String?  @db.VarChar(40)
  groupName  String?  @db.VarChar(100)
  maxMembers Int      @default(6)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section     CourseSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  enrollments SectionEnrollment[]
  chatRooms   ChatRoom[]

  @@unique([id, sectionId], map: "uniq_group_section")
  @@index([sectionId], map: "idx_section")
}

model SectionEnrollment {
  id        Int  @id @default(autoincrement())
  sectionId Int
  studentId Int
  groupId   Int?

  status     EnrollmentStatus @default(enrolled)
  enrolledAt DateTime         @default(now())

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   SectionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([sectionId, studentId], map: "uniq_section_student")
  @@index([studentId])
  @@index([sectionId])
  @@index([groupId])
}

enum MaterialCategory {
  lecture
  slide
  exercise
  reference
  syllabus
  other
}

model Material {
  id            Int              @id @default(autoincrement())
  title         String
  description   String?
  fileName      String?
  filePath      String?
  fileSize      BigInt?
  fileType      String?
  originalMaterialId String   @db.VarChar(100) 
  category      MaterialCategory @default(other)
  isPublic      Boolean          @default(false)
  downloadCount Int              @default(0)
  uploadedBy    Int
  uploadedAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  uploader    User             @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  courseLinks CourseMaterial[] @relation("MaterialToCourse")
}

model CourseMaterial {
  id              Int      @id @default(autoincrement())
  courseSectionId Int
  materialId      Int
  assignedBy      Int      // ← THÊM DÒNG NÀY
  assignedAt      DateTime @default(now())
  isOpen          Boolean  @default(true)

  courseSection CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  material      Material      @relation("MaterialToCourse", fields: [materialId], references: [id], onDelete: Cascade)
  assigner      User          @relation(fields: [assignedBy], references: [id], onDelete: Cascade) // ← THÊM DÒNG NÀY

  @@unique([courseSectionId, materialId])
  @@index([assignedBy]) // ← THÊM INDEX
}

model ForumThread {
  id        Int      @id @default(autoincrement())
  sectionId Int
  title     String   @db.VarChar(200)
  content   String   @db.Text
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("UserThreads", fields: [createdBy], references: [id], onDelete: Cascade)

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  posts   ForumPost[]
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  threadId  Int
  content   String   @db.Text
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Int      @default(0)
  author    User     @relation("UserPosts", fields: [createdBy], references: [id], onDelete: Cascade)

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(system)
  title     String           @db.VarChar(200)
  message   String?          @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  chatMessageId Int?
  assignmentId  Int?
  sectionId     Int?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  assignment  Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  section     CourseSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

enum NotificationType {
  system
  chat
  assignment
  section
}

model Reminder {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String   @db.VarChar(200)
  remindAt  DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id          Int      @id @default(autoincrement())
  studentId   Int
  userId      Int
  title       String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   LearningItem[]
}

model LearningItem {
  id                 Int     @id @default(autoincrement())
  learningPathId     Int
  resourceType       String  @db.VarChar(50)
  resourceUrl        String? @db.VarChar(500)
  recommendationNote String? @db.Text
  priority           Int     @default(1)

  path LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String   @db.VarChar(200)
  target    String?  @db.VarChar(200)
  details   Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// ===== HỆ THỐNG ĐIỂM DANH =====

model AttendanceSession {
  id          Int       @id @default(autoincrement())
  sectionId   Int
  name        String?
  sessionCode String    @unique
  qrCodeUrl   String?
  latitude    Float?
  longitude   Float?
  radius      Float?    @default(50)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

requireDeviceCheck Boolean @default(true)
  maxCheckInsPerIP   Int     @default(3)  // Giới hạn số lần điểm danh/IP
  allowedDevices     Json?                // Danh sách device đã được phép
  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  attendances  Attendance[]
  gradeColumns GradeColumnAttendanceSession[]
}

model Attendance {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  studentId   Int
  status      AttendanceStatus @default(present)
  checkedInAt DateTime         @default(now())

  latitude    Float?
  longitude   Float?
  distance    Float?
  ipAddress   String? @db.VarChar(45)
  deviceInfo  String? @db.VarChar(255)
  isValid     Boolean @default(true)
 // 🔥 Thêm để chống gian lận
  userAgent   String?  @db.VarChar(500)

  score       Float?
  adjustedBy  Int?
  adjustedAt  DateTime?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId], map: "uniq_attendance")
}

model AttendanceScoreRule {
  id        Int              @id @default(autoincrement())
  sectionId Int
  status    AttendanceStatus
  score     Float
  updatedAt DateTime         @updatedAt

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, status], map: "uniq_section_status_rule")
}

enum AttendanceStatus {
  present
  late
  absent
  warning
}




// ===== HỆ THỐNG BÀI TẬP =====

enum AssignmentType {
  exercise
  quiz
  project
  exam
}

enum QuestionType {
  multiple_choice
  essay
  coding
  true_false
}

enum ProgrammingLanguage {
  javascript
  python
  java
  cpp
  csharp
}

model Question {
  id          Int          @id @default(autoincrement())
  type        QuestionType
  content     String       @db.Text
  explanation String?      @db.Text
  points      Int          @default(1)
  order       Int          @default(0)

  language    ProgrammingLanguage?
  starterCode String?              @db.Text
  timeLimit   Int?
  memoryLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments AssignmentQuestion[]
  choices     QuestionChoice[]
  testCases   TestCase[]
  answers     SubmissionAnswer[]
}

model QuestionChoice {
  id         Int     @id @default(autoincrement())
  questionId Int
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model TestCase {
  id             Int     @id @default(autoincrement())
  questionId     Int
  input          String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean @default(false)
  points         Int     @default(0)
  order          Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Submission {
  id           Int @id @default(autoincrement())
  assignmentId Int
  studentId    Int

  filePath   String? @db.VarChar(500)
  answerText String? @db.Text

  score       Float?
  maxScore    Float?
  autoGraded  Boolean   @default(false)
  feedback    String?   @db.Text
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    SubmissionAnswer[]

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model SubmissionAnswer {
  id           Int @id @default(autoincrement())
  submissionId Int
  questionId   Int

  selectedChoices Json?

  essayAnswer String? @db.Text

  codeAnswer    String?              @db.Text
  language      ProgrammingLanguage?
  executionTime Int?
  memoryUsed    Int?

  score      Float?
  maxScore   Float?
  isCorrect  Boolean?
  autoGraded Boolean  @default(false)
  feedback   String?  @db.Text

  testResults Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model Assignment {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  description String?        @db.Text
  type        AssignmentType @default(exercise)

  dueDate                DateTime?
  maxScore               Float     @default(100)
  passingScore           Float?
  timeLimit              Int?
  maxAttempts            Int?      @default(1)
  shuffleQuestions       Boolean   @default(false)
  showAnswersAfterSubmit Boolean   @default(false)
  allowLateSubmission    Boolean   @default(false)
  createdBy               Int       // ← THÊM FIELD NÀY (nếu chưa có)
  originalAssignmentId String   @db.VarChar(100) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     AssignmentQuestion[]
  submissions   Submission[]
  sectionLinks  SectionAssignment[]
  notifications Notification[]
  ChatRoom      ChatRoom[]
  gradeColumns  GradeColumnAssignment[]
}

model SectionAssignment {
  id           Int      @id @default(autoincrement())
  sectionId    Int
  assignmentId Int
  assignedAt   DateTime @default(now())
  isOpen       Boolean  @default(true)

  section    CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignment Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, assignmentId])
  @@index([assignmentId])
}

model AssignmentQuestion {
  assignmentId Int
  questionId   Int
  assignedAt   DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([assignmentId, questionId])
}

// ===== HỆ THỐNG CHAT =====

model ChatRoom {
  id        Int          @id @default(autoincrement())
  title     String?      @db.VarChar(200)
  type      ChatRoomType
  createdAt DateTime     @default(now())

  sectionId    Int?
  assignmentId Int?
  groupId      Int?

  section    CourseSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignment Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group      SectionGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  participants ChatParticipant[]
  messages     ChatMessage[]
}

enum ChatRoomType {
  private
  section
  group
  assignment
}

model ChatParticipant {
  id     Int @id @default(autoincrement())
  roomId Int
  userId Int

  joinedAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  room          ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender        User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

// ===== HỆ THỐNG XEM ĐIỂM =====

// Enum cho loại cột điểm
enum GradeColumnType {
  attendance    // Cột điểm danh
  assignment    // Cột bài tập/assignment
  midterm       // Cột giữa kì
  final         // Cột cuối kì
  participation // Cột tham gia
  project       // Cột dự án
  custom        // Cột tự định nghĩa
}

// Enum cho phương thức tính điểm
enum GradeCalculationMethod {
  average          // Trung bình cộng
  weighted_average // Trung bình có trọng số
  sum              // Tổng điểm
  best_n           // Lấy N điểm cao nhất
  latest           // Lấy điểm mới nhất
  highest          // Lấy điểm cao nhất
  percentage       // Tỷ lệ phần trăm
}

// Bảng chính: Cột điểm
model GradeColumn {
  id                    Int                     @id @default(autoincrement())
  sectionId             Int
  name                  String                  @db.VarChar(200)
  type                  GradeColumnType
  description           String?                 @db.Text
  maxScore              Float                   @default(100)
  weight                Float?
  calculationMethod     GradeCalculationMethod  @default(average)
  bestNCount            Int?
  dropLowest            Int?                    @default(0)
  isPublished           Boolean                 @default(false)
  displayOrder          Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  
  section               CourseSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attendanceSessions    GradeColumnAttendanceSession[]
  assignments           GradeColumnAssignment[]
  studentGrades         StudentGrade[]
  
  // Quan hệ với các cột khác
  parentLinks           GradeColumnLink[]       @relation("ParentColumn") // Các cột con của cột này
  childLinks            GradeColumnLink[]       @relation("ChildColumn")  // Các cột cha chứa cột này
  
  @@index([sectionId])
}

// Bảng liên kết: Cột điểm - Buổi điểm danh
model GradeColumnAttendanceSession {
  id            Int      @id @default(autoincrement())
  gradeColumnId Int
  sessionId     Int
  weight        Float?   @default(1) // Trọng số của buổi này trong cột
  addedAt       DateTime @default(now())

  gradeColumn GradeColumn       @relation(fields: [gradeColumnId], references: [id], onDelete: Cascade)
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([gradeColumnId, sessionId])
  @@index([sessionId])
}

// Bảng liên kết: Cột điểm - Assignment
model GradeColumnAssignment {
  id            Int      @id @default(autoincrement())
  gradeColumnId Int
  assignmentId  Int
  weight        Float?   @default(1) // Trọng số của assignment này trong cột
  addedAt       DateTime @default(now())

  gradeColumn GradeColumn @relation(fields: [gradeColumnId], references: [id], onDelete: Cascade)
  assignment  Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([gradeColumnId, assignmentId])
  @@index([assignmentId])
}

// Bảng lưu điểm của sinh viên cho từng cột
model StudentGrade {
  id              Int      @id @default(autoincrement())
  gradeColumnId   Int
  studentId       Int
  score           Float?   // Điểm đã tính toán
  maxScore        Float?   // Điểm tối đa
  percentage      Float?   // Phần trăm (0-100)
  note            String?  @db.Text
  isOverridden    Boolean  @default(false) // Có ghi đè thủ công không
  overriddenScore Float?   // Điểm ghi đè
  overriddenAt    DateTime?
  overriddenBy    Int?     // ID của giáo viên ghi đè
  calculatedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gradeColumn      GradeColumn @relation(fields: [gradeColumnId], references: [id], onDelete: Cascade)
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overriddenByUser User?       @relation("GradeOverriddenBy", fields: [overriddenBy], references: [id])

  @@unique([gradeColumnId, studentId])
  @@index([studentId])
  @@index([gradeColumnId])
}

// Thêm model mới để liên kết cột điểm với nhau
model GradeColumnLink {
  id              Int         @id @default(autoincrement())
  parentColumnId  Int         // Cột cha (giữa kì, cuối kì)
  childColumnId   Int         // Cột con (điểm danh, bài tập, etc)
  weight          Float?      @default(1)
  addedAt         DateTime    @default(now())
  
  parentColumn    GradeColumn @relation("ParentColumn", fields: [parentColumnId], references: [id], onDelete: Cascade)
  childColumn     GradeColumn @relation("ChildColumn", fields: [childColumnId], references: [id], onDelete: Cascade)
  
  @@unique([parentColumnId, childColumnId])
  @@index([childColumnId])
}


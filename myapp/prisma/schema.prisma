generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NHÓM 1: HỆ THỐNG XÁC THỰC & PHÂN QUYỀN (Authentication & Authorization)
// ============================================================

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  groupName   String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ============================================================
// NHÓM 2: QUẢN LÝ NGƯỜI DÙNG (User Management)
// ============================================================

enum StudentStatus {
  active
  suspended
  graduated
  dropped
}

model User {
  id            Int       @id @default(autoincrement())
  studentCode   String?   @unique @db.VarChar(30)
  email         String?   @unique @db.VarChar(100)
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(120)
  avatarUrl     String?   @db.VarChar(500)
  phone         String?   @db.VarChar(20)
  dateOfBirth   DateTime?
  address       String?   @db.VarChar(200)
  roleId        Int
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role              Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  student           Student?
  teacher           Teacher?
  refreshTokens     RefreshToken[]
  uploadedMaterials Material[]
  assignedMaterials CourseMaterial[]
  forumThreads      ForumThread[]     @relation("UserThreads")
  forumPosts        ForumPost[]       @relation("UserPosts")
  notifications     Notification[]
  reminders         Reminder[]
  learningPaths     LearningPath[]
  auditLogs         AuditLog[]
  chatMessages      ChatMessage[]
  chatParticipants  ChatParticipant[]
  overriddenGrades  StudentGrade[]    @relation("GradeOverriddenBy")

  createdQuestions  Question[]        @relation("QuestionCreator")
  createdAssignments Assignment[]     @relation("AssignmentCreator")

  @@index([roleId])
  @@index([isActive])
  @@index([lastLogin])
}

model Student {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  studentCode    String        @unique @db.VarChar(30)
  className      String?       @db.VarChar(50)
  major          String?       @db.VarChar(100)
  academicYear   String?       @db.VarChar(15)
  enrollmentYear Int?
  gpa            Decimal?      @default(0.00) @db.Decimal(4, 2)
  status         StudentStatus @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    SectionEnrollment[]
  submissions    Submission[]
  learningPaths  LearningPath[]
  attendances    Attendance[]
  studentGrades  StudentGrade[]
  fingerprints   DeviceFingerprint[] // 🔁 từ DeviceFingerprint.student
  attendanceLogs AttendanceLog[] // 🔁 từ AttendanceLog.student

  @@index([status])
  @@index([className])
  @@index([major])
}

model Teacher {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  teacherCode    String   @unique @db.VarChar(30)
  department     String?  @db.VarChar(120)
  position       String?  @db.VarChar(80)
  specialization String?  @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections           SectionInstructor[]
  subjectAssignments SubjectInstructor[] // Thêm relation này

  @@index([department])
  @@index([position])
}

// ============================================================
// NHÓM 3: QUẢN LÝ HỌC PHẦN & LỚP HỌC (Course & Section Management)
// ============================================================

enum CourseSectionStatus {
  planned
  ongoing
  completed
  cancelled
}

enum InstructorRole {
  owner
  co
  ta
}

enum EnrollmentStatus {
  enrolled
  dropped
  completed
}

model Subject {
  id                 Int                 @id @default(autoincrement())
  subjectCode        String              @unique @db.VarChar(30)
  subjectName        String              @db.VarChar(200)
  credits            Int                 @default(3)
  description        String?             @db.Text
  courseSections     CourseSection[]
  subjectInstructors SubjectInstructor[] // Thêm relation này
  chapters           Chapter[]
  questions          Question[]

  @@index([subjectCode])
}

model Term {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(30)
  name      String    @db.VarChar(100)
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  courseSections CourseSection[]

  @@index([code])
}

model CourseSection {
  id              Int                 @id @default(autoincrement())
  subjectId       Int
  termId          Int
  sectionCode     String
  sectionName     String?
  schedule        Json?
  maxStudents     Int                 @default(50)
  currentStudents Int                 @default(0)
  status          CourseSectionStatus @default(planned)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  subject              Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term                 Term                  @relation(fields: [termId], references: [id], onDelete: Cascade)
  instructors          SectionInstructor[]
  groups               SectionGroup[]
  enrollments          SectionEnrollment[]
  forumThreads         ForumThread[]
  materials            CourseMaterial[]
  assignments          SectionAssignment[]
  notifications        Notification[]
  chatRooms            ChatRoom[]
  gradeColumns         GradeColumn[]
  attendanceScoreRules AttendanceScoreRule[]
  attendanceSessions   AttendanceSession[]

  @@index([subjectId])
  @@index([termId])
  @@index([sectionCode])
}

model SectionInstructor {
  sectionId  Int
  teacherId  Int
  role       InstructorRole @default(owner)
  assignedAt DateTime       @default(now())

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([sectionId, teacherId])
  @@index([teacherId])
  @@index([sectionId])
}

model SubjectInstructor {
  id         Int            @id @default(autoincrement())
  subjectId  Int
  teacherId  Int
  role       InstructorRole @default(owner)
  assignedAt DateTime       @default(now())
  assignedBy Int? // Admin đã phân công
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([isActive])
}

model SectionGroup {
  id         Int      @id @default(autoincrement())
  sectionId  Int
  groupCode  String?  @db.VarChar(40)
  groupName  String?  @db.VarChar(100)
  maxMembers Int      @default(6)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section     CourseSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  enrollments SectionEnrollment[]
  chatRooms   ChatRoom[]

  @@unique([id, sectionId], map: "uniq_group_section")
  @@index([sectionId], map: "idx_section")
}

model SectionEnrollment {
  id        Int  @id @default(autoincrement())
  sectionId Int
  studentId Int
  groupId   Int?

  status     EnrollmentStatus @default(enrolled)
  enrolledAt DateTime         @default(now())

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   SectionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([sectionId, studentId], map: "uniq_section_student")
  @@index([studentId])
  @@index([sectionId])
  @@index([groupId])
}

// ============================================================
// NHÓM 4: QUẢN LÝ TÀI LIỆU HỌC TẬP (Learning Materials)
// ============================================================

enum MaterialCategory {
  lecture
  slide
  exercise
  reference
  syllabus
  other
}

model Material {
  id                 Int              @id @default(autoincrement())
  title              String
  description        String?
  fileName           String?
  filePath           String?
  fileSize           BigInt?
  fileType           String?
  originalMaterialId String           @db.VarChar(100)
  category           MaterialCategory @default(other)
  isPublic           Boolean          @default(false)
  downloadCount      Int              @default(0)
  uploadedBy         Int
  uploadedAt         DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  link               String?
  uploader    User             @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  courseLinks CourseMaterial[] @relation("MaterialToCourse")
}

model CourseMaterial {
  id              Int      @id @default(autoincrement())
  courseSectionId Int
  materialId      Int
  assignedBy      Int
  assignedAt      DateTime @default(now())
  isOpen          Boolean  @default(true)

  courseSection CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  material      Material      @relation("MaterialToCourse", fields: [materialId], references: [id], onDelete: Cascade)
  assigner      User          @relation(fields: [assignedBy], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, materialId])
  @@index([assignedBy])
}

// ============================================================
// NHÓM 5: HỆ THỐNG BÀI TẬP & KIỂM TRA (Assignment & Assessment)
// ============================================================

enum AssignmentType {
  exercise
  quiz
  project
  exam
}

enum QuestionType {
  multiple_choice
  essay
  coding
  true_false
}

enum ProgrammingLanguage {
  javascript
  python
  java
  cpp
  csharp
  php
  html
  css
}

model Assignment {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  description String?        @db.Text
  type        AssignmentType @default(exercise)

  dueDate                DateTime?
  maxScore               Float     @default(100)
  passingScore           Float?
  timeLimit              Int?
  isPublic               Boolean   @default(false)
  maxAttempts            Int?      @default(1)
  shuffleQuestions       Boolean   @default(false)
  showAnswersAfterSubmit Boolean   @default(false)
  allowLateSubmission    Boolean   @default(false)
  createdBy              Int
    createdByUser     User    @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  originalAssignmentId   String    @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     AssignmentQuestion[]
  submissions   Submission[]
  sectionLinks  SectionAssignment[]
  notifications Notification[]
  ChatRoom      ChatRoom[]
  gradeColumns  GradeColumnAssignment[]
}

model SectionAssignment {
  id           Int      @id @default(autoincrement())
  sectionId    Int
  assignmentId Int
  assignedAt   DateTime @default(now())
  isOpen       Boolean  @default(true)

  section    CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignment Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, assignmentId])
  @@index([assignmentId])
}

model Question {
  id          Int             @id @default(autoincrement())
  type        QuestionType
  content     String          @db.Text
  explanation String?         @db.Text
  points      Int             @default(1)
  order       Int             @default(0)
  subjectId   Int?
  chapterId   Int?
  difficulty  DifficultyLevel @default(medium)
  tags        String?         @db.VarChar(500)
  isPublic    Boolean  @default(true)

  language    ProgrammingLanguage?
  starterCode String?              @db.Text
  timeLimit   Int?
  memoryLimit Int?

  // ✅ Lưu với User thay vì Teacher
  createdBy   Int?
  createdByUser User? @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  subject     Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapter     Chapter?             @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  assignments AssignmentQuestion[]
  choices     QuestionChoice[]
  testCases   TestCase[]
  answers     SubmissionAnswer[]

  @@index([createdBy])
  @@index([subjectId])
  @@index([chapterId])
}

model AssignmentQuestion {
  assignmentId Int
  questionId   Int
  assignedAt   DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([assignmentId, questionId])
}

model QuestionChoice {
  id         Int     @id @default(autoincrement())
  questionId Int
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

enum DifficultyLevel {
  easy
  medium
  hard
}

// Model quản lý chương
model Chapter {
  id          Int      @id @default(autoincrement())
  subjectId   Int
  chapterCode String   @db.VarChar(30)
  chapterName String   @db.VarChar(200)
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([subjectId, chapterCode])
  @@index([subjectId])
  @@index([chapterCode])
}

model TestCase {
  id             Int     @id @default(autoincrement())
  questionId     Int
  input          String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean @default(false)
  points         Int     @default(0)
  order          Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Submission {
  id           Int @id @default(autoincrement())
  assignmentId Int
  studentId    Int

  filePath   String? @db.VarChar(500)
  answerText String? @db.Text

  score       Float?
  maxScore    Float?
  autoGraded  Boolean   @default(false)
  feedback    String?   @db.Text
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?
  attempt     Int       @default(1) // 👈 số lần nộp
  isFinal     Boolean   @default(false) // 👈 submission được chọn để tính điểm

  startedAt   DateTime?
  completedAt DateTime?

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    SubmissionAnswer[]

  @@index([studentId])
  @@index([assignmentId])
}

enum JudgeStatus {
  queued
  running
  graded
  pending_review  // 🔥 THÊM
  passed
  failed
  compile_error
  runtime_error
  timeout
}
model SubmissionAnswer {
  id           Int @id @default(autoincrement())
  submissionId Int
  questionId   Int

  essayAnswer     String?              @db.Text

  codeAnswer      String?              @db.Text
  language        ProgrammingLanguage?
  filePath        String?              @db.VarChar(500) // nếu nộp folder zip
  isFolder        Boolean              @default(false)
  selectedChoices Int[]

  score       Float?
  maxScore    Float?
  judgeStatus JudgeStatus @default(queued)
  compileLog  String?     @db.Text
  stdoutLog   String?     @db.Text
  stderrLog   String?     @db.Text
  testResults Json? // lưu chi tiết testcase

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ============================================================
// NHÓM 6: HỆ THỐNG ĐIỂM DANH (Attendance System)
// ============================================================

enum AttendanceStatus {
  present
  late
  absent
  warning
}

model AttendanceSession {
  id           Int       @id @default(autoincrement())
  sectionId    Int
  name         String?
  sessionCode  String    @unique
  qrCodeUrl    String?
  latitude     Float?
  longitude    Float?
  radius       Float?    @default(50)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  sessionScore Float?    @default(10)

  requireDeviceCheck Boolean @default(true)
  maxCheckInsPerIP   Int     @default(3)
  allowedDevices     Json?

  // === TOTP dynamic QR ===
  totpSecretBase32 String? // bí mật, chỉ trả về cho GV
  totpPeriod       Int?    @default(10) // 10s/step
  totpDigits       Int?    @default(6) // 6 chữ số

  section        CourseSection                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
  gradeColumns   GradeColumnAttendanceSession[]
  nonces         AttendanceNonce[] // 🔁 từ AttendanceNonce.session
  fingerprints   DeviceFingerprint[] // 🔁 từ DeviceFingerprint.session
  attendanceLogs AttendanceLog[] // 🔁 từ AttendanceLog.session
}

model Attendance {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  studentId   Int
  status      AttendanceStatus @default(present)
  checkedInAt DateTime         @default(now())

  latitude   Float?
  longitude  Float?
  distance   Float?
  ipAddress  String? @db.VarChar(45)
  deviceInfo String? @db.VarChar(255)
  isValid    Boolean @default(true)
  userAgent  String? @db.VarChar(500)

  score      Float?
  adjustedBy Int?
  adjustedAt DateTime?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId], map: "uniq_attendance")
}

model AttendanceScoreRule {
  id        Int              @id @default(autoincrement())
  sectionId Int
  status    AttendanceStatus
  score     Float
  updatedAt DateTime         @updatedAt

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, status], map: "uniq_section_status_rule")
}

model AttendanceNonce {
  value     String            @id
  sessionId Int
  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  expiresAt DateTime
  used      Boolean           @default(false)
  createdAt DateTime          @default(now())
}

model DeviceFingerprint {
  id        Int      @id @default(autoincrement())
  studentId Int
  sessionId Int // ← THÊM TRƯỜNG NÀY
  deviceId  String
  userAgent String
  createdAt DateTime @default(now())

  student Student           @relation(fields: [studentId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // ← CHỈ 1 deviceId DÙNG CHO 1 session
  @@unique([sessionId, deviceId], name: "uniq_session_device")
  @@index([studentId])
  @@index([sessionId])
}

model AttendanceLog {
  id        Int      @id @default(autoincrement())
  studentId Int
  sessionId Int
  ipAddress String
  userAgent String
  ipCountry String?
  ipCity    String?
  flags     String?
  note      String?
  createdAt DateTime @default(now())

  student Student           @relation(fields: [studentId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [id])
}

// ============================================================
// NHÓM 7: HỆ THỐNG TÍNH ĐIỂM (Grade Management)
// ============================================================

/// Cấu hình cột điểm cho từng CourseSection
/// Mỗi cột điểm có thể là: điểm chuyên cần, điểm đồ án, hoặc điểm quá trình
enum GradeColumnType {
  attendance_final    // Điểm chuyên cần (kết hợp điểm danh + bài tập)
  project            // Điểm đồ án
  process            // Điểm quá trình (tổng hợp tất cả)
}

/// Cách tính điểm cho cột điểm
enum GradeCalculationMethod {
  manual             // Nhập tay
  auto_sum           // Tự động cộng tổng các thành phần
  auto_average       // Tự động tính trung bình
  weighted_average   // Tính theo trọng số (dùng cho điểm quá trình)
}

/// Bảng cấu hình cột điểm cho từng lớp học phần
model GradeColumn {
  id           Int                      @id @default(autoincrement())
  sectionId    Int
  
  name         String                   @db.VarChar(100)  // Tên cột: "Điểm chuyên cần", "Điểm đồ án", "Điểm quá trình"
  type         GradeColumnType
  method       GradeCalculationMethod   @default(auto_average)
  
  maxScore     Float                    @default(10)      // Điểm tối đa (thường là 10)
  weight       Float?                    @default(0)       // Trọng số trong điểm tổng (0. 1, 0.4, 0. 5...)
  
  displayOrder Int                      @default(0)       // Thứ tự hiển thị
  isActive     Boolean                  @default(true)
  
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  
  section                 CourseSection                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  // Relations đến các nguồn điểm
  attendanceSessions      GradeColumnAttendanceSession[] // Link đến các buổi điểm danh
  assignments             GradeColumnAssignment[]        // Link đến các bài tập/đồ án
  dependentColumns        GradeColumnDependency[]        @relation("DependentColumn")    // Cột này phụ thuộc vào cột nào
  sourceForColumns        GradeColumnDependency[]        @relation("SourceColumn")       // Cột này là nguồn cho cột nào
  
  // Điểm sinh viên
  studentGrades           StudentGrade[]
  
  @@unique([sectionId, name])
  @@index([sectionId, type])
  @@index([isActive])
}

/// Liên kết giữa cột điểm và buổi điểm danh
/// Dùng để tính điểm danh tự động từ nhiều buổi
model GradeColumnAttendanceSession {
  id               Int      @id @default(autoincrement())
  gradeColumnId    Int
  attendanceSessionId Int
  
  weight           Float    @default(1)  // Trọng số của buổi này (thường để bằng nhau)
  maxScore         Float?                 // Điểm tối đa của buổi (override từ AttendanceSession. sessionScore)
  
  createdAt        DateTime @default(now())
  
  gradeColumn      GradeColumn       @relation(fields: [gradeColumnId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  
  @@unique([gradeColumnId, attendanceSessionId])
  @@index([gradeColumnId])
  @@index([attendanceSessionId])
}

/// Liên kết giữa cột điểm và bài tập
/// Dùng để tính điểm bài tập hoặc đồ án tự động
model GradeColumnAssignment {
  id            Int      @id @default(autoincrement())
  gradeColumnId Int
  assignmentId  Int
  
  weight        Float    @default(1)  // Trọng số của bài này
  maxScore      Float?                // Điểm tối đa (override từ Assignment.maxScore)
  
  createdAt     DateTime @default(now())
  
  gradeColumn   GradeColumn @relation(fields: [gradeColumnId], references: [id], onDelete: Cascade)
  assignment    Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  @@unique([gradeColumnId, assignmentId])
  @@index([gradeColumnId])
  @@index([assignmentId])
}

/// Quan hệ phụ thuộc giữa các cột điểm
/// Ví dụ: Cột "Điểm quá trình" phụ thuộc vào "Điểm chuyên cần" và "Điểm đồ án"
model GradeColumnDependency {
  id                  Int      @id @default(autoincrement())
  dependentColumnId   Int      // Cột đích (cột sẽ được tính)
  sourceColumnId      Int      // Cột nguồn (cột dùng để tính)
  
  weight              Float    @default(1)  // Trọng số/hệ số của cột nguồn trong công thức
  
  createdAt           DateTime @default(now())
  
  dependentColumn     GradeColumn @relation("DependentColumn", fields: [dependentColumnId], references: [id], onDelete: Cascade)
  sourceColumn        GradeColumn @relation("SourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  
  @@unique([dependentColumnId, sourceColumnId])
  @@index([dependentColumnId])
  @@index([sourceColumnId])
}

/// Điểm của sinh viên cho mỗi cột điểm
model StudentGrade {
  id            Int      @id @default(autoincrement())
  studentId     Int
  gradeColumnId Int
  
  score         Float?                    // Điểm thực tế
  maxScore      Float    @default(10)    // Điểm tối đa
  
  isAutoCalculated Boolean @default(true) // true = tự động tính, false = nhập tay
  calculatedAt     DateTime?               // Thời điểm tính điểm tự động lần cuối
  
  // Thông tin override/điều chỉnh điểm
  isOverridden     Boolean   @default(false)
  overriddenScore  Float?                 // Điểm sau khi điều chỉnh
  overriddenBy     Int?                   // Admin/GV điều chỉnh
  overriddenAt     DateTime? 
  overrideReason   String?   @db.Text
  
  note             String?   @db.Text     // Ghi chú
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradeColumn      GradeColumn @relation(fields: [gradeColumnId], references: [id], onDelete: Cascade)
  overriddenByUser User?       @relation("GradeOverriddenBy", fields: [overriddenBy], references: [id], onDelete: SetNull)
  
  @@unique([studentId, gradeColumnId])
  @@index([studentId])
  @@index([gradeColumnId])
  @@index([isOverridden])
}


// ============================================================
// NHÓM 8: DIỄN ĐÀN & THẢO LUẬN (Forum & Discussion)
// ============================================================

model ForumThread {
  id        Int      @id @default(autoincrement())
  sectionId Int
  title     String   @db.VarChar(200)
  content   String   @db.Text
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User          @relation("UserThreads", fields: [createdBy], references: [id], onDelete: Cascade)
  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  posts   ForumPost[]
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  threadId  Int
  content   String   @db.Text
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Int      @default(0)

  author User        @relation("UserPosts", fields: [createdBy], references: [id], onDelete: Cascade)
  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

// ============================================================
// NHÓM 9: HỆ THỐNG CHAT (Chat System)
// ============================================================

enum ChatRoomType {
  private
  section
  group
  assignment
}

model ChatRoom {
  id        Int          @id @default(autoincrement())
  title     String?      @db.VarChar(200)
  type      ChatRoomType
  createdAt DateTime     @default(now())

  sectionId    Int?
  assignmentId Int?
  groupId      Int?

  section    CourseSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignment Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group      SectionGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  participants ChatParticipant[]
  messages     ChatMessage[]
}

model ChatParticipant {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  room          ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender        User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

// ============================================================
// NHÓM 10: THÔNG BÁO & NHẮC NHỞ (Notification & Reminder)
// ============================================================

enum NotificationType {
  system
  chat
  assignment
  section
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(system)
  title     String           @db.VarChar(200)
  message   String?          @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  chatMessageId Int?
  assignmentId  Int?
  sectionId     Int?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  assignment  Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  section     CourseSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model Reminder {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String   @db.VarChar(200)
  remindAt  DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// NHÓM 11: LỘ TRÌNH HỌC TẬP (Learning Path)
// ============================================================

model LearningPath {
  id          Int      @id @default(autoincrement())
  studentId   Int
  userId      Int
  title       String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   LearningItem[]
}

model LearningItem {
  id                 Int     @id @default(autoincrement())
  learningPathId     Int
  resourceType       String  @db.VarChar(50)
  resourceUrl        String? @db.VarChar(500)
  recommendationNote String? @db.Text
  priority           Int     @default(1)

  path LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

// ============================================================
// NHÓM 12: NHẬT KÝ KIỂM TOÁN (Audit Log)
// ============================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String   @db.VarChar(200)
  target    String?  @db.VarChar(200)
  details   Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
